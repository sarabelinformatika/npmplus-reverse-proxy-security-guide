# Copy to .env outside public version control and restrict to 0600.
TZ=Europe/Budapest
NPMPLUS_IMAGE=docker.io/zoeyvid/npmplus:REVIEWED_TAG_OR_DIGEST
NPMPLUS_DATA=/opt/npmplus

# Management interface: keep private.
NPM_LISTEN_LOCALHOST=true

# Explicitly review before enabling.
LOGROTATE=true
LOGROTATIONS=14
GOA=false
DISABLE_H3_QUIC=false

# Do not place real secrets in this example.
# COOKIE_SECRET=GENERATE_AND_STORE_SECURELY
# OIDC_CLIENT_SECRET=STORE_SECURELY

